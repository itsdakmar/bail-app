---
interface Props {
  activePage: string;
}
const { activePage } = Astro.props;

const links = [
  { href: '/',                  label: 'Home',                          key: 'home' },
  { href: '/legal-foundation',  label: "Article's Legal Foundation",    key: 'legal-foundation' },
  { href: '/faq',               label: 'FAQ',                           key: 'faq' },
  { href: '/procedure',         label: 'Illustration on Procedure',     key: 'procedure' },
  { href: '/game-companion',    label: 'Game Companion',                key: 'game-companion' },
];
---

<nav class="nav" aria-label="Primary">
  <div class="nav-inner">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3v18"/><path d="M5 21h14"/><path d="M5 6h14"/>
          <path d="M5 6l-3 7a3 3 0 0 0 6 0L5 6z"/>
          <path d="M19 6l-3 7a3 3 0 0 0 6 0L19 6z"/>
        </svg>
      </span>
      <span>
        <span class="brand-text">Constitutional Bail</span>
        <span class="brand-sub">A Study by Group 7 · Class B</span>
      </span>
    </a>
    <div class="nav-links">
      {links.map(l => (
        <a href={l.href} class={activePage === l.key ? 'active' : ''}>{l.label}</a>
      ))}
    </div>
  </div>
</nav>
